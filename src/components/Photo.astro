---
/** Foto optimizada (AVIF/WebP + JPG de respaldo, varios anchos) a partir de src/assets/photos. */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  widths?: number[];
  class?: string;
  eager?: boolean;
}
const { src, alt, sizes = '(min-width: 900px) 50vw, 100vw', widths = [400, 640, 900, 1200], class: cls, eager = false } = Astro.props;
const w = widths.filter((x) => x <= src.width);
if (!w.length) w.push(src.width);
---
<Picture
  src={src}
  alt={alt}
  formats={['webp']}
  fallbackFormat="jpg"
  widths={w}
  sizes={sizes}
  quality={70}
  class={cls}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
/>
