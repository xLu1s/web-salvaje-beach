---
/** Sello circular giratorio con el texto de la bandera del local. Decorativo. */
import { site } from '../data/site';
import Sun from './Sun.astro';
interface Props { class?: string }
const { class: cls } = Astro.props;
const uid = `seal-${Math.random().toString(36).slice(2, 8)}`;
const text = `Salvaje Beach · ${site.seal} · `;
---
<div class:list={['seal', cls]} aria-hidden="true">
  <svg class="seal__ring" viewBox="0 0 200 200">
    <defs><path id={uid} d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" /></defs>
    <text><textPath href={`#${uid}`} textLength="488">{text.toUpperCase()}</textPath></text>
  </svg>
  <Sun class="seal__sun" />
</div>
